# Non-secret Cloud Functions params, committed on purpose.
#
# A non-interactive `firebase deploy` (the deploy-backend workflow) refuses to
# run while any defineString/defineInt param has no value in a dotenv file,
# even when the code gives it a default. These params are not secrets, so
# their values live here; Firebase loads this file first and then
# `.env.<project>` (written from the FUNCTIONS_ENV secret), which wins on any
# key it also sets. NEVER put a secret or an API key in this file.

# Uids allowed to review recovery library photos (admin callables).
ADMIN_UIDS=zmlidDcLE4VZnnE99d3m5diCEIJ2
# Gemini image model for recovery library photos (served on location "global").
IMAGE_MODEL=gemini-3.1-flash-image
# App-wide cap on new library photos generated per day.
PHOTO_DAILY_CAP=10
